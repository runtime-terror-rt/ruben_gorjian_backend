{
  "info": {
    "_postman_id": "talexia-enterprise-plan-2026",
    "name": "Talexia Enterprise Plan",
    "description": "Standalone enterprise quote flow: admin creates a custom proposal, client signs up first, verifies email, logs in, then completes checkout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "admin",
                "login"
              ]
            },
            "description": "Logs in an admin user. Postman cookie jar should keep the session for the next admin requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enterprise Admin",
      "item": [
        {
          "name": "Create Enterprise Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Enterprise Growth\",\n  \"companyName\": \"Omega Holdings\",\n  \"fullName\": \"Md Masud Rana\",\n  \"email\": \"enterprise.client@example.com\",\n  \"industry\": \"RESTAURANT_HOSPITALITY\",\n  \"socialPlatforms\": [\n    \"INSTAGRAM\",\n    \"FACEBOOK\",\n    \"TIKTOK\"\n  ],\n  \"postsPerMonth\": 40,\n  \"reelsPerMonth\": 20,\n  \"microReelsPerMonth\": 30,\n  \"proPhotoShootFrequency\": \"Monthly\",\n  \"proPhotoShootLength\": \"4 hours\",\n  \"captionHashtags\": true,\n  \"scheduling\": true,\n  \"amount\": 1250,\n  \"billingCycle\": \"MONTHLY\",\n  \"expiresInDays\": 7,\n  \"internalNotes\": \"Priority client. Needs onboarding follow-up.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites"
              ]
            },
            "description": "Creates the enterprise proposal, stores the quoted price in the database, and sends the invite email."
          },
          "response": []
        },
        {
          "name": "Update Enterprise Invite",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"Enterprise Growth\",\n  \"companyName\": \"Omega Holdings\",\n  \"fullName\": \"Md Masud Rana\",\n  \"email\": \"enterprise.client@example.com\",\n  \"industry\": \"RESTAURANT_HOSPITALITY\",\n  \"socialPlatforms\": [\n    \"INSTAGRAM\",\n    \"FACEBOOK\",\n    \"TIKTOK\"\n  ],\n  \"postsPerMonth\": 40,\n  \"reelsPerMonth\": 20,\n  \"microReelsPerMonth\": 30,\n  \"proPhotoShootFrequency\": \"Monthly\",\n  \"proPhotoShootLength\": \"4 hours\",\n  \"captionHashtags\": true,\n  \"scheduling\": true,\n  \"amount\": 1350,\n  \"billingCycle\": \"MONTHLY\",\n  \"expiresInDays\": 14,\n  \"internalNotes\": \"Updated quote after scope change.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites/{{enterpriseInviteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites",
                "{{enterpriseInviteId}}"
              ]
            },
            "description": "Updates the enterprise proposal, invite snapshot, and custom plan price in one request."
          },
          "response": []
        },
        {
          "name": "List Enterprise Invites",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites?status=PENDING&search=Omega&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "search",
                  "value": "Omega"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Lists enterprise invites with optional search and status filters."
          },
          "response": []
        },
        {
          "name": "Resend Enterprise Invite",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites/{{enterpriseInviteId}}/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites",
                "{{enterpriseInviteId}}",
                "resend"
              ]
            },
            "description": "Refreshes the token and sends the invite email again."
          },
          "response": []
        },
        {
          "name": "Cancel Enterprise Invite",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites/{{enterpriseInviteId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites",
                "{{enterpriseInviteId}}",
                "cancel"
              ]
            },
            "description": "Cancels an invite and marks its enterprise proposal as canceled."
          },
          "response": []
        },
        {
          "name": "Enterprise Invite Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites/{{enterpriseInviteId}}/details",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites",
                "{{enterpriseInviteId}}",
                "details"
              ]
            },
            "description": "Returns invite + proposal + user + related subscription details."
          },
          "response": []
        },
        {
          "name": "Permanent Delete Enterprise Invite",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/enterprise-plan/invites/{{enterpriseInviteId}}/permanent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "enterprise-plan",
                "invites",
                "{{enterpriseInviteId}}",
                "permanent"
              ]
            },
            "description": "Hard delete invite/proposal records; removes custom plan if unused."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enterprise Client",
      "item": [
        {
          "name": "Validate Enterprise Invite",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/enterprise-invite/validate?token={{enterpriseInviteToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "enterprise-invite",
                "validate"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{enterpriseInviteToken}}"
                }
              ]
            },
            "description": "Validates the invite token and returns the quoted enterprise proposal preview."
          },
          "response": []
        },
        {
          "name": "Signup From Enterprise Invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
               "raw": "{\n  \"token\": \"{{enterpriseInviteToken}}\",\n  \"password\": \"{{enterpriseUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup-enterprise-invite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup-enterprise-invite"
              ]
            },
            "description": "Creates the account first and sends verification email before payment."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{emailVerificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ]
            },
            "description": "Verifies the email and opens the authenticated session."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{enterpriseUserEmail}}\",\n  \"password\": \"{{enterpriseUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Signs in the enterprise user after verification."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Checkout Enterprise Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planCode\": \"{{enterprisePlanCode}}\",\n  \"billingCycle\": \"monthly\",\n  \"termsAccepted\": true,\n  \"addonPlatformQty\": 0,\n  \"videoSessionHours\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/billing/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "billing",
                "checkout"
              ]
            },
            "description": "Starts Stripe checkout using the quoted enterprise price stored in the database."
          },
          "response": []
        },
        {
          "name": "Get Add-on Pricing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/billing/addons/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "billing",
                "addons",
                "pricing"
              ]
            },
            "description": "Returns the current video-session and platform add-on pricing plus the active subscription snapshot."
          },
          "response": []
        },
        {
          "name": "Buy Video Session Hours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoSessionHours\": {{videoSessionHours}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/billing/addons/video-session/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "billing",
                "addons",
                "video-session",
                "checkout"
              ]
            },
            "description": "Starts a one-time Stripe checkout for prepaid video session hours at $495/hr."
          },
          "response": []
        },
        {
          "name": "Add Platform Quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addonPlatformQty\": {{platformAddonQty}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/billing/addons/platforms/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "billing",
                "addons",
                "platforms",
                "checkout"
              ]
            },
            "description": "Updates the active subscription with extra platform quantity at the configured recurring add-on price."
          },
          "response": []
        }
      ]
    }
