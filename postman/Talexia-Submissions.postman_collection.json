          "name": "Submissions - Download Enhanced Delivery File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}/enhanced-deliveries/{{deliveryId}}/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}",
