              "raw": "{\n  \"message\": \"Here is the enhanced delivery package\",\n  \"files\": [\n    {\n      \"fileName\": \"enhanced-delivery.pdf\",\n      \"mimeType\": \"application/pdf\",\n      \"size\": 2097152\n    },\n    {\n      \"fileName\": \"asset-bundle.zip\",\n      \"mimeType\": \"application/zip\",\n      \"size\": 5242880\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions/{{submissionId}}/enhanced-deliveries",
