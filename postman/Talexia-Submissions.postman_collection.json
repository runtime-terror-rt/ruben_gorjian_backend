{
  "info": {
    "_postman_id": "talexia-submissions-2026",
    "name": "Talexia Submissions",
    "description": "All user and admin APIs for the submissions module: quota, creation, uploads, status management, enhanced deliveries, and file downloads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "User APIs",
      "item": [
        {
          "name": "Submissions - Quota Snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/quota",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "quota"
              ]
            },
            "description": "Get the current visual quota snapshot for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Submissions - Create Submission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNote\": \"Please review these files\",\n  \"files\": [\n    {\n      \"fileName\": \"design-brief.pdf\",\n      \"fileType\": \"application/pdf\",\n      \"fileSize\": 5242880\n    },\n    {\n      \"fileName\": \"reference-image.png\",\n      \"fileType\": \"image/png\",\n      \"fileSize\": 3145728\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions"
              ]
            },
            "description": "Create a submission and receive presigned upload URLs for the files."
          },
          "response": []
        },
        {
          "name": "Submissions - Complete File Uploads",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"files\": [\n    {\n      \"fileName\": \"design-brief.pdf\",\n      \"fileType\": \"application/pdf\",\n      \"fileSize\": 5242880,\n      \"storageKey\": \"submissions/{{userId}}/sample-file-1\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}/files/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}",
                "files",
                "complete"
              ]
            },
            "description": "Confirm uploaded files and attach them to an existing submission."
          },
          "response": []
        },
        {
          "name": "Submissions - Presign Single File Retry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"files\": [\n    {\n      \"fileName\": \"design-brief.pdf\",\n      \"fileType\": \"application/pdf\",\n      \"fileSize\": 5242880\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}/presign-single",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}",
                "presign-single"
              ]
            },
            "description": "Generate a fresh presigned upload URL for a single file retry."
          },
          "response": []
        },
        {
          "name": "Submissions - List My Submissions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "List submissions for the authenticated user with pagination."
          },
          "response": []
        },
        {
          "name": "Submissions - Get Submission Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}"
              ]
            },
            "description": "Get one submission with files and status events."
          },
          "response": []
        },
        {
          "name": "Submissions - List Enhanced Deliveries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}/enhanced-deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}",
                "enhanced-deliveries"
              ]
            },
            "description": "List enhanced deliveries attached to a submission."
          },
          "response": []
        },
