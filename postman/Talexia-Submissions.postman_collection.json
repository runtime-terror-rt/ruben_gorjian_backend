          "response": []
        },
        {
          "name": "Submissions - Download Completed Submission File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/submissions/{{submissionId}}/files/{{fileId}}/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "submissions",
                "{{submissionId}}",
                "files",
                "{{fileId}}",
                "download"
              ]
            },
            "description": "Get a signed download URL for a completed submission file."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Admin - List All Submissions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions?status=SUBMITTED&sort=date&order=desc&limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "submissions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SUBMITTED"
                },
                {
                  "key": "sort",
                  "value": "date"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "List all submissions with filters, sorting, and pagination."
          },
          "response": []
        },
        {
          "name": "Admin - Get Submission Detail",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions/{{submissionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "submissions",
                "{{submissionId}}"
              ]
            },
            "description": "Get one submission with full user, file, and event details."
          },
          "response": []
        },
        {
          "name": "Admin - Update Submission Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_REVIEW\",\n  \"adminNote\": \"Checked and in progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions/{{submissionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "submissions",
                "{{submissionId}}"
              ]
            },
            "description": "Update the submission status and attach an admin note."
          },
          "response": []
        },
        {
          "name": "Admin - List Enhanced Deliveries",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAuthToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions/{{submissionId}}/enhanced-deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
