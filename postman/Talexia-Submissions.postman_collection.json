                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "submissions",
                "{{submissionId}}",
                "enhanced-deliveries"
              ]
            },
            "description": "Create an enhanced delivery and receive presigned upload URLs for admin files."
