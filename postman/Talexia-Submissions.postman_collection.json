            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"files\": [\n    {\n      \"fileName\": \"enhanced-delivery.pdf\",\n      \"mimeType\": \"application/pdf\",\n      \"size\": 2097152,\n      \"storageKey\": \"submissions/{{submissionId}}/enhanced/{{adminId}}/sample-file-1\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/submissions/{{submissionId}}/enhanced-deliveries/{{deliveryId}}/complete",
              "host": [
                "{{baseUrl}}"
