{
  "info": {
    "_postman_id": "talexia-case-studies-2026",
    "name": "Talexia Case Studies Management",
    "description": "Case studies endpoints for authenticated users and admin-only management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Case Studies - Get Active (User/Admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/case-studies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "case-studies"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - Create Case Study",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"From 1x to 3x Leads in 60 Days\",\n  \"summary\": \"How a boutique brand increased qualified leads using Talexia workflows.\",\n  \"content\": \"We redesigned publishing cadence, optimized posting windows, and improved asset quality.\",\n  \"displayOrder\": 1,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/case-studies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "case-studies"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - Update Case Study",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"From 1x to 3.2x Leads in 60 Days\",\n  \"summary\": \"Updated summary\",\n  \"content\": \"Updated full content\",\n  \"displayOrder\": 2,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/case-studies/{{caseStudyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "case-studies",
            "{{caseStudyId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - Delete Case Study",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/case-studies/{{caseStudyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "case-studies",
            "{{caseStudyId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "your_admin_token_here",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "your_user_token_here",
      "type": "string"
    },
    {
      "key": "caseStudyId",
      "value": "case_study_id_from_create_or_list",
      "type": "string"
    }
  ]
}
