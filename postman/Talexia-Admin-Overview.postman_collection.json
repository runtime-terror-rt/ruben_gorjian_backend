{
  "info": {
    "_postman_id": "3a4dd7c4-7f1a-4d68-a8fd-5d4d7f4db0cb",
    "name": "Talexia Admin Overview API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Admin overview endpoints for stats, revenue trend, and activity feed."
  },
  "item": [
    {
      "name": "Overview Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/overview/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "overview",
            "stats"
          ]
        }
      }
    },
    {
      "name": "Overview Revenue Trend",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/overview/revenue?year={{year}}&month={{month}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "overview",
            "revenue"
          ],
          "query": [
            {
              "key": "year",
              "value": "{{year}}"
            },
            {
              "key": "month",
              "value": "{{month}}",
              "description": "Use All or a month name such as January, February, March, April, May, June, July, August, September, October, November, December."
            }
          ]
        }
      }
    },
    {
      "name": "Overview Activity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/overview/activity?page={{activityPage}}&limit={{activityLimit}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "overview",
            "activity"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{activityPage}}"
            },
            {
              "key": "limit",
              "value": "{{activityLimit}}"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "year",
      "value": "2026"
    },
    {
      "key": "month",
      "value": "All"
    },
    {
      "key": "activityPage",
      "value": "1"
    },
    {
      "key": "activityLimit",
      "value": "50"
    }
  ]
}
