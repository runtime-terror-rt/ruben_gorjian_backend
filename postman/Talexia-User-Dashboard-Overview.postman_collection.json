{
  "info": {
    "_postman_id": "talexia-user-dashboard-overview-2026",
    "name": "Talexia User Dashboard Overview",
    "description": "User dashboard overview APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Dashboard - Overview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview"
          ]
        },
        "description": "Aggregated overview payload for user dashboard home"
      },
      "response": []
    },
    {
      "name": "Dashboard - Recent Activity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/recent-activity?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "recent-activity"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Paginated recent activity feed for user"
      },
      "response": []
    },
    {
      "name": "Dashboard - Upcoming Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/upcoming-posts?days=7&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "upcoming-posts"
          ],
          "query": [
            {
              "key": "days",
              "value": "7"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Upcoming scheduled posts within a configurable day range"
      },
      "response": []
    },
    {
      "name": "Dashboard - Post Pipeline",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/post-pipeline",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "post-pipeline"
          ]
        },
        "description": "Post pipeline counts for dashboard widgets"
      },
      "response": []
    },
    {
      "name": "Dashboard - System Alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/system-alerts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "system-alerts"
          ]
        },
        "description": "Actionable alerts computed from quota, subscription, failures and account health"
      },
      "response": []
    },
    {
      "name": "Dashboard - Subscription Progress",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/subscription-progress",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "subscription-progress"
          ]
        },
        "description": "Shows current add-on state including purchased video hours and platform quantity."
      },
      "response": []
    },
    {
      "name": "Scheduler - Book Video Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleType\": \"VIDEO_SESSION\",\n  \"scheduledAt\": \"{{videoSessionScheduledAt}}\",\n  \"sessionTitle\": \"Video Session Booking\",\n  \"sessionNotes\": \"Booked from Postman after add-on purchase\",\n  \"sessionDurationMinutes\": {{sessionDurationMinutes}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/scheduler/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scheduler",
            "sessions"
          ]
        },
        "description": "Books a video session and should fail with payment-required until the add-on hours are purchased."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "your_user_token_here",
      "type": "string"
    },
    {
      "key": "videoSessionScheduledAt",
      "value": "2026-04-24T10:00:00.000Z",
      "type": "string"
    },
    {
      "key": "sessionDurationMinutes",
      "value": "60",
      "type": "string"
    }
  ]
}
