{
  "info": {
    "_postman_id": "talexia-user-dashboard-overview-2026",
    "name": "Talexia User Dashboard Overview",
    "description": "User dashboard overview APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Dashboard - Overview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview"
          ]
        },
        "description": "Aggregated overview payload for user dashboard home"
      },
      "response": []
    },
    {
      "name": "Dashboard - Recent Activity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/recent-activity?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "recent-activity"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Paginated recent activity feed for user"
      },
      "response": []
    },
    {
      "name": "Dashboard - Upcoming Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/upcoming-posts?days=7&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "upcoming-posts"
          ],
          "query": [
            {
              "key": "days",
              "value": "7"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        },
        "description": "Upcoming scheduled posts within a configurable day range"
      },
      "response": []
    },
    {
      "name": "Dashboard - Post Pipeline",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/post-pipeline",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "post-pipeline"
          ]
        },
        "description": "Post pipeline counts for dashboard widgets"
      },
      "response": []
    },
    {
      "name": "Dashboard - System Alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/system-alerts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "system-alerts"
          ]
        },
        "description": "Actionable alerts computed from quota, subscription, failures and account health"
      },
      "response": []
    },
    {
      "name": "Dashboard - Subscription Progress",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/overview/subscription-progress",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "overview",
            "subscription-progress"
          ]
        },
        "description": "Shows current add-on state including purchased video hours and platform quantity."
      },
      "response": []
    },
    {
      "name": "Scheduler - Book Video Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleType\": \"VIDEO_SESSION\",\n  \"scheduledAt\": \"{{videoSessionScheduledAt}}\",\n  \"sessionTitle\": \"Video Session Booking\",\n  \"sessionNotes\": \"Booked from Postman after add-on purchase\",\n  \"sessionDurationMinutes\": {{sessionDurationMinutes}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/scheduler/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scheduler",
            "sessions"
          ]
        },
        "description": "Books a video session and should fail with payment-required until the add-on hours are purchased."
      },
      "response": []
    },
    {
      "name": "Settings - Get Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "settings"
          ]
        },
        "description": "Fetch the current user profile and business settings"
      },
      "response": []
    },
    {
      "name": "Uploads - Presign Avatar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"{{avatarFileName}}\",\n  \"contentType\": \"{{avatarContentType}}\",\n  \"fileSize\": {{avatarFileSize}},\n  \"purpose\": \"avatar\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/uploads/presign",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "uploads",
            "presign"
          ]
        },
        "description": "Create an avatar upload target and save the returned storage key for the settings update",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "try {",
                "  const json = pm.response.json();",
                "  if (json && json.storageKey) {",
                "    pm.environment.set('avatarStorageKey', json.storageKey);",
                "    console.log('Saved avatarStorageKey:', json.storageKey);",
                "  }",
                "} catch (error) {",
                "  console.log('Unable to parse avatar presign response', error);",
                "}"
              ]
            }
          }
        ]
      },
      "response": []
    },
    {
      "name": "Settings - Update Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile\": {\n    \"fullName\": \"{{profileFullName}}\",\n    \"bio\": \"{{profileBio}}\",\n    \"avatar\": {\n      \"storageKey\": \"{{avatarStorageKey}}\",\n      \"contentType\": \"{{avatarContentType}}\"\n    }\n  },\n  \"business\": {\n    \"name\": \"{{businessName}}\",\n    \"website\": \"{{businessWebsite}}\",\n    \"industry\": \"{{businessIndustry}}\",\n    \"timezone\": \"{{businessTimezone}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/user/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "settings"
          ]
        },
        "description": "Update profile and business settings. Run the avatar presign request first if you want to update the photo."
      },
      "response": []
    },
    {
      "name": "Settings - Remove Avatar",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/user/settings/photo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "settings",
            "photo"
          ]
        },
        "description": "Remove only the profile photo without changing other settings"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "your_user_token_here",
      "type": "string"
    },
    {
      "key": "videoSessionScheduledAt",
      "value": "2026-04-24T10:00:00.000Z",
      "type": "string"
    },
    {
      "key": "sessionDurationMinutes",
      "value": "60",
      "type": "string"
    },
    {
      "key": "profileFullName",
      "value": "Test User",
      "type": "string"
    },
    {
      "key": "profileBio",
      "value": "Updated from Postman",
      "type": "string"
    },
    {
      "key": "businessName",
      "value": "Talexia",
      "type": "string"
    },
    {
      "key": "businessWebsite",
      "value": "https://example.com",
      "type": "string"
    },
    {
      "key": "businessIndustry",
      "value": "Retail",
      "type": "string"
    },
    {
      "key": "businessTimezone",
      "value": "Asia/Dhaka",
      "type": "string"
    },
    {
      "key": "avatarFileName",
      "value": "avatar",
      "type": "string"
    },
    {
      "key": "avatarContentType",
      "value": "image/png",
      "type": "string"
    },
    {
      "key": "avatarFileSize",
      "value": "102400",
      "type": "string"
    },
    {
      "key": "avatarStorageKey",
      "value": "",
      "type": "string"
    }
  ]
}
